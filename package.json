{
  "name": "shag-ai-plugins",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform marketplace for reusable AI-agent workflows and project tools.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "eval:skill": "node scripts/run-skill-evals.mjs",
    "eval:assess-change-complexity": "node scripts/run-skill-evals.mjs evals/engineering-tools/assess-change-complexity/cases.json",
    "eval:technical-writing": "node scripts/run-skill-evals.mjs evals/engineering-tools/technical-writing/cases.json",
    "eval:unslop": "node scripts/run-skill-evals.mjs evals/ai-quality/unslop/cases.json",
    "eval:bro": "node scripts/run-skill-evals.mjs evals/ai-quality/bro/cases.json",
    "eval:plan-web-app": "node scripts/run-skill-evals.mjs evals/web-development/plan-web-app/cases.json",
    "validate": "node scripts/validate.mjs",
    "validate:structure": "node scripts/validate-marketplace.mjs",
    "test": "node --test"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
